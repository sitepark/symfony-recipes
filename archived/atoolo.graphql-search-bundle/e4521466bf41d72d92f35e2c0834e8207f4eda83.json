{
    "manifests": {
        "atoolo/graphql-search-bundle": {
            "manifest": {
                "bundles": {
                    "Atoolo\\GraphQL\\Search\\AtooloGraphQLSearchBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "src/resources/graphql/queries/": "src/resources/graphql/queries/"
                }
            },
            "files": {
                "config/packages/atoolo_graphql.yaml": {
                    "contents": [
                        "atoolo_graphql:",
                        "  graphql_query_dirs:",
                        "    - '%kernel.project_dir%/src/resources/graphql/queries'"
                    ],
                    "executable": false
                },
                "config/packages/graphql.yaml": {
                    "contents": [
                        "overblog_graphql:",
                        "  definitions:",
                        "    mappings:",
                        "      types:",
                        "        - types: [yaml, graphql]",
                        "          dir: \"%atoolo_graphql_search.config_dir%/graphql/defaults\"",
                        "          suffix: ~",
                        "        - types: [yaml, graphql]",
                        "          dir: \"%kernel.project_dir%/config/graphql/types\"",
                        "          suffix: ~",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/graphql.yaml": {
                    "contents": [
                        "overblog_graphql_endpoint:",
                        "    resource: \"@OverblogGraphQLBundle/Resources/config/routing/graphql.yml\"",
                        "    prefix: /api/graphql",
                        "",
                        ""
                    ],
                    "executable": false
                },
                "src/resources/graphql/queries/search.graphql": {
                    "contents": [
                        "# example search query",
                        "",
                        "query search(",
                        "    $input: SearchInput!",
                        ") {",
                        "    search(input: $input) {",
                        "        total",
                        "        offset",
                        "        limit",
                        "        queryTime",
                        "        results {",
                        "            ...resource",
                        "        }",
                        "    }",
                        "}",
                        "",
                        "fragment resource on Resource {",
                        "    id",
                        "    name",
                        "}",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "e4521466bf41d72d92f35e2c0834e8207f4eda83"
        }
    }
}
